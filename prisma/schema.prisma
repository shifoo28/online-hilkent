enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id        String      @id @default(uuid())
  orderId   String      @unique
  userId    String
  status    OrderStatus @default(PENDING)
  total     Decimal // use Decimal for money
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  OrderItems OrderItem[] // one-to-many relation
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal // snapshot of product price at order time

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Category {
  id        Int      @id @default(autoincrement()) // auto-incrementing integer ID
  name      String   @unique
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id         String   @id @default(cuid())
  price      Float
  categoryId Int
  inStock    Boolean  @default(true)
  rating     Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  Reviews      Review[]
  Properties   ProductProperty[]
  Translations ProductTranslation[]
  Discounts    Discount[]
  Images       ProductImage[]
  OrderItems   OrderItem[]
  heroProduct   HeroProduct? // one-to-one relation to HeroProduct (optional)

  Category Category @relation(fields: [categoryId], references: [id])
}

model HeroProduct {
  id        Int      @id @default(autoincrement())
  productId String   @unique // one-to-one relation with Product
  isSlider  Boolean  @default(true) // true for slider, false for static hero
  headline  String
  subline   String
  image     String
  position  Int      @default(0) // for ordering slides
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String // image URL (CDN, S3, etc.)
  thumbnail String
  altText   String? // optional accessibility text, SEO friendly
  position  Int     @default(0) // optional ordering (e.g., 0 = main image)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Discount {
  id        String       @id @default(cuid())
  type      DiscountType
  value     Int // percentage or fixed amount
  startDate DateTime
  endDate   DateTime
  productId String?

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  locale      Locale
  name        String
  description String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum Locale {
  US
  RU
  TM
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      @default(5) // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discount       Float
  minOrderAmount Float? // Minimum order amount required to use coupon
  maxUsageCount  Int? // Maximum number of times coupon can be used
  usageCount     Int          @default(0) // Current usage count
  isActive       Boolean      @default(true)
  expiryDate     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([code])
  @@index([expiryDate])
}

model ProductProperty {
  id             Int      @id @default(autoincrement())
  productId      String
  propertyNameId Int
  value          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  name    PropertyName @relation(fields: [propertyNameId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PropertyName {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties               ProductProperty[]
  propertyNameTranslations PropertyNameTranslation[]
}

model PropertyNameTranslation {
  id             Int    @id @default(autoincrement())
  propertyNameId Int
  locale         Locale
  name           String

  propertyName PropertyName @relation(fields: [propertyNameId], references: [id], onDelete: Cascade)
}
