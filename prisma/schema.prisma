generator client {
    provider   = "prisma-client-js"
    engineType = "binary" // Use the binary engine for better performance
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id              Int       @id @default(autoincrement())
    name            String?
    email           String?   @unique
    phone           String    @unique
    // authentication fields
    passwordHash    String?
    isActive        Boolean   @default(true)
    emailVerifiedAt DateTime?
    // profile fields
    avatar          String?   @default("/images/users/default-avatar.jpg")
    bio             String?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    // relations
    orders          Order[]
    reviews         Review[]
    // posts           Post[]
    // wishlist        Wishlist[]
}

