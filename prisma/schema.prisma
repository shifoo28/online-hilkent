generator client {
  provider   = "prisma-client-js"
  engineType = "binary" // Use the binary engine for better performance
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  phone           Int       @unique
  name            String?
  email           String?   @unique
  // authentication fields
  passwordHash    String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  // profile fields
  avatar          String?   @default("/images/users/default-avatar.jpg")
  bio             String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // relations
  Orders          Order[]
  Reviews         Review[]
  // accounts         Account[]
  // sessions         Session[]
}

