model Order {
    id        Int         @id @default(autoincrement())
    orderId   String      @unique
    userId    Int
    status    OrderStatus @default(PENDING)
    total     String
    title     String // product title or order description
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
    user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
    PENDING
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
}

model Product {
    id        Int      @id @default(autoincrement())
    price     Float
    image     String?
    category  String?
    inStock   Boolean  @default(true)
    rating    Float?   @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    reviews      Review[]
    properties   ProductProperty[]
    translations ProductTranslation[]
    Discount     Discount[]
    ProductImage ProductImage[]
}

model HeroSlider {
    id        Int      @id @default(autoincrement())
    title     String
    subtitle  String?
    image     String
    link      String?
    position  Int      @default(0) // for ordering slides
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ProductImage {
    id        String  @id @default(cuid())
    url       String // image URL (CDN, S3, etc.)
    thumbnail String
    altText   String? // optional accessibility text, SEO friendly
    position  Int? // optional ordering (e.g., 1 = main image)
    productId Int

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Discount {
    id        String       @id @default(cuid())
    type      DiscountType
    value     Int // percentage or fixed amount
    startDate DateTime
    endDate   DateTime
    productId Int?

    product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum DiscountType {
    PERCENTAGE
    FIXED
}

model ProductTranslation {
    id          Int     @id @default(autoincrement())
    productId   Int
    locale      Locale
    name        String
    description String?

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum Locale {
    EN
    RU
    TM
}

model Review {
    id        Int      @id @default(autoincrement())
    userId    Int
    productId Int
    rating    Int      @default(5) // 1-5 stars
    comment   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
    id                 Int       @id @default(autoincrement())
    code               String    @unique
    description        String?
    discountAmount     Float? // Fixed discount amount
    discountPercentage Float? // Percentage discount (0-100)
    minOrderAmount     Float? // Minimum order amount required to use coupon
    maxUsageCount      Int? // Maximum number of times coupon can be used
    usageCount         Int       @default(0) // Current usage count
    isActive           Boolean   @default(true)
    expiryDate         DateTime?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt

    @@index([code])
    @@index([expiryDate])
}

model ProductProperty {
    id             Int      @id @default(autoincrement())
    productId      Int
    propertyNameId Int
    value          String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    name    PropertyName @relation(fields: [propertyNameId], references: [id], onDelete: Cascade)
    product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@index([productId])
}

model PropertyName {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    properties               ProductProperty[]
    propertyNameTranslations PropertyNameTranslation[]
}

model PropertyNameTranslation {
    id             Int    @id @default(autoincrement())
    propertyNameId Int
    locale         Locale
    name           String

    propertyName PropertyName @relation(fields: [propertyNameId], references: [id], onDelete: Cascade)
}

enum Color {
    RED
    GREEN
    BLUE
    YELLOW
    BLACK
    WHITE
}
